# Anthropic — analisi dal vivo e Ask Kalamos grounded.
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Sessione del workspace. Impostare una stringa lunga e casuale nei deployment reali.
# Senza questa variabile l'app usa un fallback DEMO, non adatto a dati editoriali reali.
# KALAMOS_SESSION_SECRET=replace-with-a-long-random-secret

# Credenziali riservate opzionali per la presentazione.
# KALAMOS_DEMO_EMAIL=editor@publisher.example
# KALAMOS_DEMO_PASSWORD=replace-me

# Imposta true per disabilitare il pulsante di accesso pubblico al workspace demo.
# KALAMOS_DISABLE_PUBLIC_DEMO=false

# Fusibili di /api/analyze
# KALAMOS_API_TOKEN=un-token-lungo-a-caso
# NEXT_PUBLIC_KALAMOS_API_TOKEN=un-token-lungo-a-caso
# KALAMOS_ALLOWED_ORIGIN=https://kalamos-ai.vercel.app
# KALAMOS_MAX_COST_USD=1.00

# Modulo «Richiedi un pilota» (/pilota). Senza queste il modulo propone una
# mail già compilata verso l'emailContatto di config/azienda.ts.
# RESEND_API_KEY=re_...
# Destinatario delle richieste (altrimenti emailContatto di config/azienda.ts).
# KALAMOS_LEADS_TO=fondatore@example.com
# Mittente. Quello di prova di Resend consegna solo all'indirizzo dell'account
# Resend; per un mittente proprio serve il dominio verificato su Resend.
# KALAMOS_MAIL_FROM=Kalamos <onboarding@resend.dev>

# Indirizzo pubblico del sito, per sitemap, robots e anteprime dei link.
# NEXT_PUBLIC_SITE_URL=https://kalamos-ai.vercel.app
