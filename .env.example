# Chiave API Anthropic — necessaria per l'analisi dal vivo (paste/upload e
# "ri-analizza dal vivo"). Le 4 schede demo restano disponibili anche senza chiave.
ANTHROPIC_API_KEY=sk-ant-...

# (Opzionale) Modello da usare. Default: claude-sonnet-4-6 (rapido, sta nei 10s
# del piano Vercel Hobby). Su piano Pro puoi alzare la qualità con Opus.
# ANTHROPIC_MODEL=claude-opus-4-8

# ── Fusibili dell'endpoint di analisi ──────────────────────────────────────
# Token condiviso. Se impostato, /api/analyze rifiuta le richieste che non lo
# portano (header x-kalamos-token oppure Authorization: Bearer). Se NON è
# impostato l'endpoint resta aperto, come nella demo pubblica.
# KALAMOS_API_TOKEN=un-token-lungo-a-caso
# Copia lato client, necessaria perché il browser possa chiamare l'endpoint.
# Attenzione: finisce nel bundle, quindi NON è un segreto.
# NEXT_PUBLIC_KALAMOS_API_TOKEN=un-token-lungo-a-caso

# Filtra le richieste per origine. Se non impostata, nessun filtro.
# KALAMOS_ALLOWED_ORIGIN=https://kalamos-ai.vercel.app

# Tetto di spesa stimato per singola analisi, in dollari (default 1.00).
# KALAMOS_MAX_COST_USD=1.00
