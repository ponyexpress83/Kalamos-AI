# Chiave API Anthropic — necessaria per l'analisi dal vivo (paste/upload e
# "ri-analizza dal vivo"). Le 4 schede demo restano disponibili anche senza chiave.
ANTHROPIC_API_KEY=sk-ant-...

# (Opzionale) Modello da usare. Default: claude-sonnet-4-6 (rapido, sta nei 10s
# del piano Vercel Hobby). Su piano Pro puoi alzare la qualità con Opus.
# ANTHROPIC_MODEL=claude-opus-4-8
