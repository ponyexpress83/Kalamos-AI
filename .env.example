# Chiave API Anthropic — necessaria per l'analisi dal vivo (paste/upload e
# "ri-analizza dal vivo"). Le 4 schede demo restano disponibili anche senza chiave.
ANTHROPIC_API_KEY=sk-ant-...

# (Opzionale) Modello da usare. Default: claude-opus-4-8.
# Per una demo più veloce/economica dal vivo puoi usare claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-opus-4-8
